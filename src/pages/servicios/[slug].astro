---
export function getStaticPaths() {
	return [
		{ params: { slug: 'jardines-terrazas' }, props: { destination: '/reformas' } },
		{ params: { slug: 'pergolas-celosias' }, props: { destination: '/madera' } },
		{ params: { slug: 'fachadas-revestimientos' }, props: { destination: '/madera' } },
		{ params: { slug: 'reformas-interiores' }, props: { destination: '/reformas' } },
	];
}

const { destination } = Astro.props;
return Astro.redirect(destination, 301);
