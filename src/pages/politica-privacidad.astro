---
import LegalDocument from '../components/LegalDocument.astro';
import { getLegalPage } from '../data/editorial';
import { getPage } from '../lib/tina/data';

const legalPage = getLegalPage('politica-privacidad');
if (!legalPage) throw new Error('Legal page not found: politica-privacidad');
const home = await getPage('home');
---

<LegalDocument page={legalPage} navigationData={home.data?.page} />
