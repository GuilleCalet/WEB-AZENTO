---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import EditorialHero from '../components/EditorialHero.astro';
import HomeStructure from '../components/HomeStructure.astro';
import HomePortfolioHeader from '../components/HomePortfolioHeader.astro';
import DivisionShowcase from '../components/DivisionShowcase.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { divisions, projects, siteSettings } from '../data/editorial';
import { getPage } from '../lib/tina/data';
import { islands } from '../lib/tina/islands';

const page = await getPage('home');
const pageData = page.data?.page;
const featuredProjects = projects.filter((project) => project.featured).slice(0, 3);
const madera = divisions.find((division) => division.slug === 'madera');
const reformas = divisions.find((division) => division.slug === 'reformas');
---

<Layout
	title={pageData?.title || 'AZento Home'}
	description={pageData?.description || 'Madera tecnológica y reformas integrales en Madrid.'}
>
	<TinaIsland name="homeNavbar" wrapper={islands.homeNavbar.wrapper}>
		<Navbar data={pageData} />
	</TinaIsland>

	<main>
		<TinaIsland name="homeEditorialHero" wrapper={islands.homeEditorialHero.wrapper} primary>
			<EditorialHero data={pageData} />
		</TinaIsland>

		<TinaIsland name="homeStructure" wrapper={islands.homeStructure.wrapper}>
			<HomeStructure data={pageData} />
		</TinaIsland>

		{madera && (
			<TinaIsland name="divisionShowcase" params={{ slug: 'madera' }} wrapper={islands.divisionShowcase.wrapper}>
				<DivisionShowcase division={madera} projects={projects.filter((p) => p.division === 'madera')} />
			</TinaIsland>
		)}
		{reformas && (
			<TinaIsland name="divisionShowcase" params={{ slug: 'reformas', reverse: 'true' }} wrapper={islands.divisionShowcase.wrapper}>
				<DivisionShowcase division={reformas} projects={projects.filter((p) => p.division === 'reformas')} reverse />
			</TinaIsland>
		)}

		<section id="proyectos" class="bg-white py-20 lg:py-28">
			<div class="mx-auto max-w-7xl px-6">
				<TinaIsland name="homePortfolioHeader" wrapper={islands.homePortfolioHeader.wrapper}>
					<HomePortfolioHeader data={pageData} />
				</TinaIsland>
				<div class="grid gap-4 lg:grid-cols-3">
					{featuredProjects.map((project, index) => (
						<TinaIsland name="projectCard" params={{ slug: project.slug, featured: index === 0 ? 'true' : 'false' }} wrapper={islands.projectCard.wrapper}>
							<ProjectCard project={project} labels={siteSettings.projectCard} featured={index === 0} />
						</TinaIsland>
					))}
				</div>
			</div>
		</section>

		<TinaIsland name="homeContact" wrapper={islands.homeContact.wrapper}>
			<Contact data={pageData} />
		</TinaIsland>
	</main>

	<TinaIsland name="homeFooter" wrapper={islands.homeFooter.wrapper}>
		<Footer data={pageData} />
	</TinaIsland>
</Layout>
