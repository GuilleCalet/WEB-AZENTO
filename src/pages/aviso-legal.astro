---
import LegalDocument from '../components/LegalDocument.astro';
import { getLegalPage } from '../data/editorial';
import { getPage } from '../lib/tina/data';

const legalPage = getLegalPage('aviso-legal');
if (!legalPage) throw new Error('Legal page not found: aviso-legal');
const home = await getPage('home');
---

<LegalDocument page={legalPage} navigationData={home.data?.page} />
