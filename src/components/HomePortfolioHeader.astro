---
// @ts-nocheck
import { tinaField } from '@tinacms/astro/tina-field';
import type { PageQuery } from '../../tina/__generated__/types';

interface Props {
	data?: PageQuery['page'] | null;
}

const { data } = Astro.props;
const editorial = data?.editorialHome;
---

<div class="mb-12 flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
	<div>
		<p
			class="mb-6 text-[0.68rem] uppercase tracking-[0.42em] text-accent-600"
			data-tina-field={editorial ? tinaField(editorial, 'portfolioEyebrow') : undefined}
		>
			{editorial?.portfolioEyebrow}
		</p>
		<h2 class="font-display text-5xl text-azento-950 sm:text-6xl">
			<span data-tina-field={editorial ? tinaField(editorial, 'portfolioPrefix') : undefined}>{editorial?.portfolioPrefix}</span>
			<em
				class="font-normal text-azento-600"
				data-tina-field={editorial ? tinaField(editorial, 'portfolioAccent') : undefined}
			>
				{editorial?.portfolioAccent}
			</em>
		</h2>
	</div>
	<a
		href="/proyectos"
		class="text-sm text-azento-600 hover:text-azento-800"
		data-tina-field={editorial ? tinaField(editorial, 'allProjectsLabel') : undefined}
	>
		{editorial?.allProjectsLabel} ↗
	</a>
</div>
